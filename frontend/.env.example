# Copy to .env.local and fill in your values before building.
# These are baked into the static bundle at build time (Next.js static export).
# You CANNOT change them after the build — set them correctly before `next build`.

# --- Railway / production ---
# Replace the placeholder URLs with your actual Railway service URLs.
# Use wss:// (not ws://) for WebSocket when the frontend is served over HTTPS.
# Use https:// (not http://) for the API URL when served over HTTPS.
#
# Example:
#   NEXT_PUBLIC_API_URL=https://unfoldx-backend.up.railway.app
#   NEXT_PUBLIC_WORKSPACE_WS_URL=wss://unfoldx-backend.up.railway.app/ws/workspace

# REST base URL for the FastAPI backend.
NEXT_PUBLIC_API_URL=https://YOUR_BACKEND.up.railway.app

# WebSocket base URL. The frontend appends /{workspace_id} automatically.
NEXT_PUBLIC_WORKSPACE_WS_URL=wss://YOUR_BACKEND.up.railway.app/ws/workspace

# Which workspace to open on load (must match DEMO_WORKSPACE_ID on the backend).
NEXT_PUBLIC_WORKSPACE_ID=demo-workspace

# Set to 1 to run against the built-in mock event generator instead of a real backend.
# Leave as 0 (or unset) for production.
NEXT_PUBLIC_MOCK=0

# Default URL shown in the "Live preview" window on the canvas.
NEXT_PUBLIC_PREVIEW_URL=
